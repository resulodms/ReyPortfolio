@model List<ToDoList>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Yapılacaklar</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Yapılacaklar Listesi</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Yapılacaklar ile ilgili işlemleri aşşağıdan panelden yapabilirsiniz.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">İçerik</th>
									<th scope="col">Tarih</th>
									<th scope="col">Durum</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var x in Model)
								{
									<tr>
										<td>@x.ToDoListId</td>
										<td>@x.Title</td>
										<td>@x.Date</td>
										@if (x.Status == true)
										{
											<td><a href="/ToDoList/ChangeToDoListFalse/@x.ToDoListId" class="btn btn-dark">Yapıldı </a></td>
										}
										else
										{
											<td><a href="/ToDoList/ChangeToDoListTrue/@x.ToDoListId" class="btn btn-info">Yapılmadı</a></td>
										}
										<td><a href="/ToDoList/DeleteToDoList/@x.ToDoListId" class="btn btn-danger" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</a></td>
										<td><a href="/ToDoList/UpdateToDoList/@x.ToDoListId" class="btn btn-success">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/ToDoList/CreateToDoList/" class="btn btn-primary">Yeni Yapılacak İşlem Girişi</a>
					</div>
				</div>


			</div>

		</div>
	</div>
</div>