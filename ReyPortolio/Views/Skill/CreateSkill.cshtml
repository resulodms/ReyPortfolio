@model Skill
@{
	ViewData["Title"] = "CreateSkill";
	Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Deneyimler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Yetenek Ekleme Sayfası</div>
					</div>
					<div class="card-body">

						<form method="post">
							<label>Yetenek Bilgisi</label>
							<input type="text" asp-for="Title" class="form-control" />
							<br />

							<label>%'de Değeri</label>
							<input type="number" asp-for="Value" class="form-control" />
							<br />

							
							<button class="btn btn-primary">Yetenek Kaydet</button>
						</form>

					</div>
				</div>


			</div>

		</div>
	</div>
</div>
