@model List<Skill>
@{
	ViewData["Title"] = "SkillList";
	Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Yetenekler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Deneyim Listesi</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Yetenek ile ilgili işlemleri aşşağıdan yapabilirsiniz.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Yetenek</th>
									<th scope="col">Seviye</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
									
								</tr>
							</thead>
							<tbody>
								@foreach (var x in Model)
								{
									<tr>
										<td>@x.SkillId</td>
										<td>@x.Title</td>
										<td><div class="progress"><div class="progress-bar" style="width:@x.Value%">@x.Value%</div></div></td>
										<td><a href="/Skill/DeleteSkill/@x.SkillId" class="btn btn-danger" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</a></td>
										<td><a href="/Skill/UpdateSkill/@x.SkillId" class="btn btn-success">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Skill/CreateSkill/" class="btn btn-primary">Yeni Yetenek Girişi</a>
					</div>
				</div>


			</div>

		</div>
	</div>
</div>

