@model List<Portfolio>
@{
	ViewData["Title"] = "Projelerim";
	Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Portfolyo</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Projelerim</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Projeler ile ilgili işlemleri aşşağıdan yapabilirsiniz.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Görsel</th>
									<th scope="col">Proje Adı</th>
									<th scope="col">Kategori</th>
									<th scope="col">Link</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>

								</tr>
							</thead>
							<tbody>
								@foreach (var x in Model)
								{
									<tr>
										<td>@x.PortfolioId</td>
										<td><img src="@x.ImageUrl" width="80" /></td>
										<td>@x.Title</td>
										<td>@x.Subtitle</td>
										<td><a href="@x.Url" target="_blank">Projeye Git</a></td>
										<td><a href="/Portfolio/DeletePortfolio/@x.PortfolioId" class="btn btn-danger" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</a></td>
										<td><a href="/Portfolio/UpdatePortfolio/@x.PortfolioId" class="btn btn-success">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Portfolio/CreatePortfolio/" class="btn btn-primary">Yeni Proje Ekle</a>
					</div>
				</div>


			</div>

		</div>
	</div>
</div>

