@model List<Testimonial>
@{
	ViewData["Title"] = "Projelerim";
	Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Referanslar</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Referanslarım</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Referanslara Göre Düzenle.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Fotoğraf</th>
									<th scope="col">Ad Soyad</th>
									<th scope="col">Unvan</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>

								</tr>
							</thead>
							<tbody>
								@foreach (var x in Model)
								{
									<tr>
										<td>@x.TestimonialId</td>
										<td><img src="@x.ImageUrl" width="50" class="rounded-circle" /></td>
										<td>@x.NameSurname</td>
										<td>@x.Title</td>
										<td><a href="/Testimonial/DeleteTestimonial/@x.TestimonialId" class="btn btn-danger" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</a></td>
										<td><a href="/Testimonial/UpdateTestimonial/@x.TestimonialId" class="btn btn-success">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Testimonial/CreateTestimonial/" class="btn btn-primary">Yeni Referans Ekle</a>
					</div>
				</div>


			</div>

		</div>
	</div>
</div>

