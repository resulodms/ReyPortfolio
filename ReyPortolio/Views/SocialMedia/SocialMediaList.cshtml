@model List<SocialMedia>
@{
	ViewData["Title"] = "SocialMediaList";
	Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Sosyal Medya</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Sosyal Medya</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Sosyal Medya ile ilgili işlemleri aşşağıdan yapabilirsiniz.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Platform</th>
									<th scope="col">İkon Sınıfı</th>
									<th scope="col">Adres</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>

								</tr>
							</thead>
							<tbody>
								@foreach (var x in Model)
								{
									<tr>
										<td>@x.SocialMediaId</td>
										<td>@x.Title</td>
										<td>@x.Icon</td>
										<td>@x.Url</td>
										<td><a href="/SocialMedia/DeleteSocialMedia/@x.SocialMediaId" class="btn btn-danger" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</a></td>
										<td><a href="/SocialMedia/UpdateSocialMedia/@x.SocialMediaId" class="btn btn-success">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/SocialMedia/CreateSocialMedia/" class="btn btn-primary">Yeni Sosyal Medya Girişi</a>
					</div>
				</div>


			</div>

		</div>
	</div>
</div>

